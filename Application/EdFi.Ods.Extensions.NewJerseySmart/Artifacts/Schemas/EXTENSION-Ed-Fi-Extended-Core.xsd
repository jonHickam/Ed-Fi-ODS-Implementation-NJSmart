<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://ed-fi.org/3.3.1-b" xmlns:ann="http://ed-fi.org/annotation" targetNamespace="http://ed-fi.org/3.3.1-b" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:include schemaLocation="Ed-Fi-Core.xsd" />
  <xs:annotation>
    <xs:documentation>===== Ed-Fi 3.3.1-b Extensions =====</xs:documentation>
  </xs:annotation>
  <xs:annotation>
    <xs:documentation>===== Domain Entities =====</xs:documentation>
  </xs:annotation>
  <xs:annotation>
    <xs:documentation>===== Descriptors =====</xs:documentation>
  </xs:annotation>
  <xs:complexType name="EXTENSION-EighthTechnologicalLiteracyDescriptor">
    <xs:annotation>
      <xs:documentation>This data element is an indication of whether the student has met eighth grade technological proficiency.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-ELAGraduationPathwayIndicatorDescriptor">
    <xs:annotation>
      <xs:documentation>An indication if and how a student met the English graduation assessment requirements.  </xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-FederalHSMathTestingReqDescriptor">
    <xs:annotation>
      <xs:documentation>This field indicates whether a student has met the federal requirement to take Algebra I (or one of the exceptions noted below) while in high school.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-MathGraduationPathwayIndicatorDescriptor">
    <xs:annotation>
      <xs:documentation>An indication if and how a student met the math graduation assessment requirements.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-MilitaryConnectedStudentDescriptor">
    <xs:annotation>
      <xs:documentation>An indication that the student’s parent or guardian is on Active Duty, in the National Guard, or in the Reserve components of the United States military services.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-NonPublicDescriptor">
    <xs:annotation>
      <xs:documentation>An indication of whether or not a student is receiving or not receiving services under an individual service plan when that student has been parentally placed into a sectarian or non-sectarian private school and also has been determined eligible for special education and related services.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentLearningEnvironmentDescriptor">
    <xs:annotation>
      <xs:documentation>The chosen method for delivering instruction to the student.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-TuitionCodeDescriptor">
    <xs:annotation>
      <xs:documentation>An indicator of the source of payment for a student.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>===== Associations =====</xs:documentation>
  </xs:annotation>
  <xs:complexType name="EXTENSION-StudentEducationOrganizationAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentEducationOrganizationAssociation">
        <xs:sequence>
          <xs:element name="MunicipalCode" type="EXTENSION-MunicipalCode">
            <xs:annotation>
              <xs:documentation>The resident municipality (4 digit code) of the student</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EighthTechnologicalLiteracy" type="EXTENSION-EighthTechnologicalLiteracyDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>This data element is an indication of whether the student has met eighth grade technological proficiency.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-EighthTechnologicalLiteracyDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="MilitaryConnectedStudent" type="EXTENSION-MilitaryConnectedStudentDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indication that the student’s parent or guardian is on Active Duty, in the National Guard, or in the Reserve components of the United States military services.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-MilitaryConnectedStudentDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="HasHealthInsurance" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if the student has health insurance.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="HealthInsuranceProvider" type="EXTENSION-HealthInsuranceProvider" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The name of the health insurance provider for that student.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentLanguageInstructionProgramAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentLanguageInstructionProgramAssociation">
        <xs:sequence>
          <xs:element name="LanguageOfInstructionLanguage" type="LanguageDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>Language Instruction Educational Program</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>LanguageDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentSchoolAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentSchoolAssociation">
        <xs:sequence>
          <xs:element name="ResidentSchool" type="EXTENSION-ResidentSchool">
            <xs:annotation>
              <xs:documentation>The school (9 digit CDS code) that the student would attend based upon their permanent or other home address.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="TuitionCode" type="EXTENSION-TuitionCodeDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indicator of the source of payment for a student.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-TuitionCodeDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="NonPublic" type="EXTENSION-NonPublicDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indication of whether or not a student is receiving or not receiving services under an individual service plan when that student has been parentally placed into a sectarian or non-sectarian private school and also has been determined eligible for special education and related services.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-NonPublicDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="FederalHSMathTestingReq" type="EXTENSION-FederalHSMathTestingReqDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>This field indicates whether a student has met the federal requirement to take Algebra I (or one of the exceptions noted below) while in high school.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-FederalHSMathTestingReqDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="ELAGraduationPathwayIndicator" type="EXTENSION-ELAGraduationPathwayIndicatorDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indication if and how a student met the English graduation assessment requirements.  </xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-ELAGraduationPathwayIndicatorDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="MathGraduationPathwayIndicator" type="EXTENSION-MathGraduationPathwayIndicatorDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indication if and how a student met the math graduation assessment requirements.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-MathGraduationPathwayIndicatorDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentSpecialEducationProgramAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentSpecialEducationProgramAssociation">
        <xs:sequence>
          <xs:element name="IEPGraduationCourseRequirement" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indication of whether the IEP of a student with a disability contains an exemption or modification to the state course requirement component of NJDOE graduation requirements.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="IEPGraduationAttendance" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indication of whether the IEP of a student with a disability contains an exemption or modification to the local attendance requirement component of NJDOE graduation requirements.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>===== Extended Reference Types =====</xs:documentation>
  </xs:annotation>
  <xs:annotation>
