          </xs:element>
          <xs:element name="WorldLanguageAssessment" type="EXTENSION-WorldLanguageAssessmentDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The World Language Assessment taken by the student</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-WorldLanguageAssessmentDescriptor</ann:Descriptor>
