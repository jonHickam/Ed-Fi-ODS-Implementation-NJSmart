          <xs:element name="BridgeYearParticipationStatus" type="EXTENSION-BridgeYearParticipationStatusDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>An indication of whether the student plans to or is currently participating in the “Bridge Year Pilot Program.</xs:documentation>
              <xs:appinfo>
